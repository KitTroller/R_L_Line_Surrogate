# Python / OS
__pycache__/
*.py[cod]
.venv/
.DS_Store

# Datasets: regenerated in seconds from a seed, e.g.  python src/CLI_Dataset.py seed=0
data/

# Checkpoints: binary. Retrain from the run's config instead.
runs/

# sweeps/*.json is deliberately TRACKED: small, and the record of every result.
# graphs/ is tracked too.

# docs: third-party papers stay out; our own documents go in.
# (`docs/*` + negations; a bare `docs` could not be un-ignored per file.)
docs/*
!docs/Notes.md
!docs/Line_Generator_Build.html
